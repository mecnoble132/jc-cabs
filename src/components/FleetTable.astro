---
import Button from './Button.astro';
import Icon from './Icon.astro';
import fleet from '../data/fleet.json';
import { rupees } from '../lib/format';

// Rate card: local package, extra charges, and the hourly rate for short trips.
const row = 'lg:grid-cols-[minmax(0,2fr)_1.1fr_0.9fr_1.1fr_1fr_5rem]';
---

<!-- A ruled list, not cards: fares are tabular, so rows read faster than boxes. -->
<div>
  <div
    class:list={['hidden gap-6 border-b border-ink pb-2 text-xs font-medium text-muted lg:grid', row]}
    aria-hidden="true"
  >
    <span>Vehicle</span>
    <span>Capacity</span>
    <span>8 hr / 80 km</span>
    <span>Extra km / hour</span>
    <span>Short trips</span>
    <span></span>
  </div>
  <ul>
    {
      fleet.map((car) => (
        <li class:list={['grid gap-3 border-b border-line py-4 lg:items-center lg:gap-6', row]}>
          <div>
            <h3>{car.name}</h3>
            <p class="mt-0.5 text-sm text-muted">{car.bestFor}</p>
          </div>
          <p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
            <span class="inline-flex items-center gap-1.5">
              <Icon name="users" class="h-4 w-4 text-muted" />
              {car.seats ? `${car.seats} seats` : 'Seats TBD'}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon name="bag" class="h-4 w-4 text-muted" />
              {car.luggage}
            </span>
            {car.ac && (
              <span class="inline-flex items-center gap-1.5">
                <Icon name="snowflake" class="h-4 w-4 text-muted" />
                AC
              </span>
            )}
          </p>
          <p class="text-sm">
            <span class="text-muted lg:hidden">8 hr / 80 km: </span>
            <span class="font-semibold">{car.packageFare ? rupees(car.packageFare) : 'On request'}</span>
          </p>
          <p class="text-sm">
            <span class="text-muted lg:hidden">Extra: </span>
            {car.extraKm ? (
              <span class="font-semibold">
                {rupees(car.extraKm)}/km, {rupees(car.extraHour)}/hr
              </span>
            ) : (
              <span class="font-semibold">On request</span>
            )}
          </p>
          <p class="text-sm">
            <span class="text-muted lg:hidden">Short trips: </span>
            <span class="font-semibold">
              {car.shortTripPerHour ? `${rupees(car.shortTripPerHour)}/hr` : 'On request'}
            </span>
          </p>
          <Button href={`/?vehicle=${car.id}#book`} variant="call">
            Book
          </Button>
        </li>
      ))
    }
  </ul>
  <p class="mt-3 max-w-3xl text-xs text-muted">
    The local package covers 8 hours and 80 km. Short trips are charged per hour with 10 km included and a 4 hour
    minimum. Extra km and extra hours are charged beyond the package.
  </p>
</div>

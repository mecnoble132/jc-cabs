---
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  route: { id: string; from: string; to: string };
}

const { route } = Astro.props;
// The home page booking form reads pickup and drop from the link and fills those fields in.
const bookHref = `/?pickup=${encodeURIComponent(route.from)}&drop=${encodeURIComponent(route.to)}#book`;
---

<li class="flex items-center justify-between gap-4 border-b border-line py-3">
  <p class="flex flex-wrap items-center gap-x-2 font-medium">
    <span>{route.from}</span>
    <Icon name="arrow" class="h-4 w-4 text-muted" />
    <span>{route.to}</span>
  </p>
  <Button href={bookHref} variant="call" class="shrink-0">Book</Button>
</li>

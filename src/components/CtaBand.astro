---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { telLink, waLink, type CityKey } from '../lib/contact';
import { images } from '../lib/images';

interface Props {
  heading?: string;
  text?: string;
  /** City pages pass their city so Call dials the local office. */
  city?: CityKey;
}

const {
  heading = 'Your ride, on time. Every time.',
  text = 'Tell us where and when. We confirm quickly by phone or WhatsApp.',
  city,
} = Astro.props;
---

<!-- Photo band, left-aligned copy, three small buttons (cta.gallery "call-to-buy" pattern) -->
<section data-theme="dark" class="relative isolate overflow-hidden text-white">
  <Image
    src={images.kanyakumari}
    alt=""
    widths={[800, 1280, 1920]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/75 via-black/45 to-black/10" aria-hidden="true"></div>
  <div class="mx-auto max-w-[1200px] px-5 py-14 lg:px-8 lg:py-20">
    <h2 class="max-w-md">{heading}</h2>
    <p class="mt-3 max-w-md text-white/85">{text}</p>
    <div class="mt-6 flex flex-col gap-2 sm:flex-row">
      <Button href="/#book" variant="book" arrow>Book your taxi</Button>
      <Button href={telLink(city)} variant="call-dark" track="click_call" city={city ?? site.defaultCity}>
        <Icon name="phone" class="h-4 w-4" />
        Call
      </Button>
      <Button href={waLink()} variant="whatsapp" track="click_whatsapp">
        <Icon name="chat" class="h-4 w-4" />
        WhatsApp
      </Button>
    </div>
  </div>
</section>

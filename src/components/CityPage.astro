---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHero from './PhotoHero.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import RouteCard from './RouteCard.astro';
import CtaBand from './CtaBand.astro';
import OfficeMap from './OfficeMap.astro';
import site from '../data/site.json';
import cities from '../data/cities.json';
import routes from '../data/routes.json';
import { telLink, waLink, type CityKey } from '../lib/contact';

interface Props {
  cityKey: CityKey;
}

const { cityKey } = Astro.props;
const city = cities[cityKey];
const office = site.office;
const label = site.cities[cityKey].label;
const isOfficeCity = cityKey === office.city;
const cityRoutes = routes.filter((r) => r.city === cityKey);
---

<BaseLayout
  title={`Taxi in ${city.heading} | Airport, Local and Outstation Cabs | JC Cabs`}
  description={`${city.intro} Hatchback, sedan, Ertiga and Innova cabs, open 24 hours.`}
  city={cityKey}
  overlay
>
  <PhotoHero image={city.image} alt={city.imageAlt} title={`Taxi in ${city.heading}`} intro={city.intro}>
    <div class="mt-5 flex flex-col gap-2 sm:flex-row">
      <Button href="/#book" variant="book" arrow>Book now</Button>
      <Button href={telLink()} variant="call-dark" track="click_call" city={cityKey}>
        <Icon name="phone" class="h-4 w-4" />
        Call
      </Button>
      <Button href={waLink(`Hi, I'd like a taxi in ${label}.`)} variant="whatsapp" track="click_whatsapp">
        <Icon name="chat" class="h-4 w-4" />
        WhatsApp
      </Button>
    </div>
  </PhotoHero>

  <section class="section grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2>Airport pickups</h2>
      <p class="mt-3 text-muted">{city.airportText}</p>
      <dl class="mt-5">
        <div class="flex justify-between gap-4 border-b border-line py-3">
          <dt class="font-medium">Airport</dt>
          <dd class="text-right text-muted">{city.airport}</dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-line py-3">
          <dt class="font-medium">Pickup point</dt>
          <dd class="text-right text-muted">TBD</dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-line py-3">
          <dt class="font-medium">Popular trips</dt>
          <dd class="text-right text-muted">{city.nearby}</dd>
        </div>
      </dl>
    </div>

    <div>
      <h2>Popular routes from {label}</h2>
      <ul class="mt-3">
        {cityRoutes.map((route) => <RouteCard route={route} />)}
      </ul>
      <p class="mt-4 text-sm text-muted">
        <a href="/fleet-and-fares" class="font-medium text-ink underline underline-offset-4">See all fares</a>{' '}
        for every vehicle.
      </p>
    </div>
  </section>

  <section class="bg-cream">
    <div class="section grid gap-8 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2>Our office</h2>
        {
          !isOfficeCity && (
            <p class="mt-3 text-muted">
              Our office is in {office.label}. We serve {label} too: call or WhatsApp to book.
            </p>
          )
        }
        <dl class="mt-5">
          <div class="flex justify-between gap-4 border-b border-line py-3">
            <dt class="font-medium">Address</dt>
            <dd class="text-right text-muted">{office.address}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-line py-3">
            <dt class="font-medium">Hours</dt>
            <dd class="text-right text-muted">{office.hours}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-line py-3">
            <dt class="font-medium">Phone</dt>
            <dd class="text-right">
              <a href={telLink()} data-track="click_call" data-city={cityKey} class="underline underline-offset-4">
                {site.phoneDisplay}
              </a>
            </dd>
          </div>
        </dl>
      </div>
      <OfficeMap />
    </div>
  </section>

  <CtaBand city={cityKey} heading={city.ctaHeading} />
</BaseLayout>

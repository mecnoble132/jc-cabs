---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import { telLink, waLink, type CityKey } from '../lib/contact';
import { images } from '../lib/images';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  city?: CityKey;
}

const { city } = Astro.props;
---

<!-- Floating navbar: inset from the edges, blurred, sits over the hero (navbar.gallery pattern) -->
<header class="fixed inset-x-0 top-0 z-40 px-3 pt-3 lg:px-6 lg:pt-4">
  <div
    class="relative mx-auto flex max-w-[1200px] items-center justify-between gap-3 rounded-xl border border-line/80 bg-white/90 py-2 pr-2 pl-3 shadow-[0_4px_20px_rgba(17,24,21,0.1)] backdrop-blur-md"
  >
    <a href="/" class="flex items-center gap-2.5 text-base font-semibold tracking-tight text-ink">
      <Image src={images.logo} alt="" width={80} height={80} loading="eager" class="h-10 w-10 rounded-full" />
      {site.name}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-6 lg:flex">
      {
        site.nav.map((item) => (
          <a href={item.href} class="text-sm font-medium text-ink/80 hover:text-ink">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden lg:block">
        <Button href={telLink(city)} variant="call" track="click_call" city={city ?? site.defaultCity}>
          <Icon name="phone" class="h-4 w-4" />
          Call
        </Button>
      </div>
      <Button href="/#book" variant="book">Book now</Button>

      <!-- Native <details> menu: works without JavaScript. Panel is positioned against the navbar. -->
      <details class="lg:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-line text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="menu" class="h-5 w-5" />
        </summary>
        <nav
          aria-label="Mobile"
          class="absolute inset-x-0 top-full mt-2 rounded-xl border border-line bg-white p-4 shadow-[0_8px_30px_rgba(17,24,21,0.15)]"
        >
          <ol>
            {
              site.nav.map((item, i) => (
                <li class="border-b border-line last:border-0">
                  <a href={item.href} class="flex items-baseline gap-3 py-3">
                    <span class="w-5 text-xs font-semibold text-muted">{String(i + 1).padStart(2, '0')}</span>
                    <span class="text-lg font-medium">{item.label}</span>
                  </a>
                </li>
              ))
            }
          </ol>
          <div class="mt-3 grid grid-cols-2 gap-2">
            <Button href={telLink(city)} variant="call" track="click_call" city={city ?? site.defaultCity}>
              <Icon name="phone" class="h-4 w-4" />
              Call
            </Button>
            <Button href={waLink()} variant="whatsapp" track="click_whatsapp">
              <Icon name="chat" class="h-4 w-4" />
              WhatsApp
            </Button>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import { telLink, waLink, type CityKey } from '../lib/contact';
import { images } from '../lib/images';

const cities = Object.entries(site.cities) as [CityKey, (typeof site.cities)[CityKey]][];
const office = site.office;
const year = new Date().getFullYear();
---

<footer class="bg-forest text-white" data-theme="dark">
  <div class="mx-auto grid max-w-[1200px] gap-8 px-5 py-10 text-sm sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div>
      <Image src={images.logo} alt={site.name} width={128} height={128} loading="lazy" class="h-16 w-16 rounded-full" />
      <p class="mt-3 max-w-xs text-white/70">{site.tagline}</p>
    </div>

    <div>
      <h2 class="mb-2 text-sm font-semibold">Office</h2>
      <p class="text-white/70">{office.address}</p>
      <p class="mt-1 text-white/70">{office.hours}</p>
      <a href={telLink()} data-track="click_call" class="mt-2 inline-block font-medium underline underline-offset-4">
        Call: {site.phoneDisplay}
      </a>
      <br />
      <a href={office.mapsUrl} target="_blank" rel="noopener" class="mt-1 inline-block text-white/70 underline underline-offset-4">
        Open in Google Maps
      </a>
    </div>

    <div>
      <h2 class="mb-2 text-sm font-semibold">We serve</h2>
      {
        cities.map(([key, city]) => (
          <a href={`/taxi-in-${key}`} class="block py-0.5 text-white/70 underline underline-offset-4">
            Taxi in {city.label}
          </a>
        ))
      }
    </div>

    <div>
      <h2 class="mb-2 text-sm font-semibold">Contact</h2>
      <a href={waLink()} data-track="click_whatsapp" class="inline-block font-medium underline underline-offset-4">
        WhatsApp: {site.whatsappDisplay}
      </a>
      <br />
      <a href={`mailto:${site.email}`} class="mt-1 inline-block text-white/70 underline underline-offset-4">
        {site.email}
      </a>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div
      class="mx-auto flex max-w-[1200px] flex-col gap-2 px-5 py-4 text-xs text-white/70 lg:flex-row lg:items-center lg:justify-between lg:px-8"
    >
      <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-1">
        {
          site.footerLinks.map((link) => (
            <a href={link.href} class="underline underline-offset-4">
              {link.label}
            </a>
          ))
        }
      </nav>
      <p>&copy; {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

---
import { Image } from 'astro:assets';
import { images } from '../lib/images';

interface Props {
  /** File name (without .jpg) in src/assets/images */
  image: string;
  alt: string;
  title: string;
  intro?: string;
}

const { image, alt, title, intro } = Astro.props;
---

<!-- Compact photo header for inner pages. Pages using it pass `overlay` to BaseLayout so it sits under the navbar. -->
<section data-theme="dark" class="relative isolate flex min-h-[20rem] items-end overflow-hidden text-white lg:min-h-[26rem]">
  <Image
    src={images[image]}
    alt={alt}
    widths={[800, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/75 via-black/30 to-black/20" aria-hidden="true"></div>
  <div class="mx-auto w-full max-w-[1200px] px-5 pt-28 pb-8 lg:px-8 lg:pb-12">
    <h1 class="max-w-2xl">{title}</h1>
    {intro && <p class="mt-3 max-w-xl text-white/85">{intro}</p>}
    <slot />
  </div>
</section>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import FleetTable from '../components/FleetTable.astro';
import CtaBand from '../components/CtaBand.astro';

// Owner to supply these; every value is a visible TBD until then.
const fareNotes = [
  { label: 'Driver bata', value: 'TBD' },
  { label: 'Toll and parking', value: 'TBD' },
  { label: 'Night charges', value: 'TBD' },
  { label: 'Waiting charges', value: 'TBD' },
];
---

<BaseLayout
  title="Taxi Fleet & Fares in Trivandrum and Kochi (Cochin) | JC Cabs"
  description="Hatchback, sedan, 7-seater and Traveller taxis in Trivandrum and Kochi (Cochin). See seats, luggage space and per-km fares."
>
  <section class="section">
    <h1>Fleet and fares</h1>
    <p class="mt-3 max-w-xl text-muted">
      Four vehicle types for solo trips, families and groups. All are air-conditioned.
    </p>
    <div class="mt-8">
      <FleetTable />
    </div>
  </section>

  <section class="bg-cream">
    <div class="section">
      <h2>Fare notes</h2>
      <p class="mt-2 max-w-xl text-muted">
        The per-km rate is the base fare. These extras may apply, depending on the trip.
      </p>
      <dl class="mt-6 grid gap-x-10 sm:grid-cols-2">
        {
          fareNotes.map((note) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-3">
              <dt class="font-medium">{note.label}</dt>
              <dd class="text-muted">{note.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand
    heading="Not sure which car you need?"
    text="Tell us how many people and bags, and we will suggest the right vehicle."
  />
</BaseLayout>

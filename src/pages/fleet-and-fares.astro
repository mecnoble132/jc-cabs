---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FleetTable from '../components/FleetTable.astro';
import CtaBand from '../components/CtaBand.astro';
import { images } from '../lib/images';

// Photos of our cars, from src/assets/images. Add a file there and a line here to extend the gallery.
const gallery = [
  { key: 'car-white-sedan', alt: 'White sedan taxi parked beside greenery' },
  { key: 'car-black-sedan', alt: 'Black sedan taxi on a gravel road' },
  { key: 'cars-lineup', alt: 'Three of our taxis parked in a row' },
  { key: 'cars-pair', alt: 'Two of our taxis parked side by side' },
];

// All fare notes confirmed by the owner. Waiting charges vary by vehicle, so only the starting rate is shown.
const fareNotes = [
  { label: 'Driver bata', value: '₹500 per day on outstation trips' },
  { label: 'Toll and parking', value: 'Paid as per actuals' },
  { label: 'Night charges', value: '₹200, between 10 pm and 6 am' },
  { label: 'Waiting charges', value: 'From ₹200 per hour after the first 30 minutes, depending on the vehicle' },
];
---

<BaseLayout
  title="Taxi Fleet & Fares in Trivandrum and Kochi (Cochin) | JC Cabs"
  description="Hatchback, sedan, Ertiga and Innova taxis in Trivandrum and Kochi (Cochin). See the rate card for local packages, extra km and hourly short trips."
>
  <section class="section">
    <h1>Fleet and fares</h1>
    <p class="mt-3 max-w-xl text-muted">
      Hatchbacks, sedans, Ertigas and Innovas for solo trips, families and groups. All are air-conditioned.
    </p>
    <div class="mt-8">
      <FleetTable />
    </div>
  </section>

  <section class="mx-auto max-w-[1200px] px-5 pb-12 lg:px-8 lg:pb-[4.5rem]">
    <h2>Our cars</h2>
    <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
      {
        gallery.map((photo) => (
          <Image
            src={images[photo.key]}
            alt={photo.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 25vw, 50vw"
            loading="lazy"
            class="aspect-[4/5] w-full rounded-xl object-cover"
          />
        ))
      }
    </div>
  </section>

  <section class="bg-cream">
    <div class="section">
      <h2>Fare notes</h2>
      <p class="mt-2 max-w-xl text-muted">
        These extras may apply, depending on the trip.
      </p>
      <dl class="mt-6 grid gap-x-10 sm:grid-cols-2">
        {
          fareNotes.map((note) => (
            <div class="flex items-baseline justify-between gap-4 border-b border-line py-3">
              <dt class="font-medium">{note.label}</dt>
              <dd class="text-muted">{note.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand
    heading="Not sure which car you need?"
    text="Tell us how many people and bags, and we will suggest the right vehicle."
  />
</BaseLayout>

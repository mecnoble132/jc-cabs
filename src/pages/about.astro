---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoHero from '../components/PhotoHero.astro';
import CtaBand from '../components/CtaBand.astro';

// Owner to supply these; every value is a visible TBD until then.
const facts = [
  { label: 'In business since', value: 'TBD' },
  { label: 'Fleet size', value: 'TBD' },
  { label: 'Vehicle classes', value: 'Hatchback, sedan, Ertiga, Innova' },
  { label: 'Cities', value: 'Trivandrum and Kochi (Cochin)' },
  { label: 'Licences and permits', value: 'TBD' },
];
---

<BaseLayout
  title="About JC Cabs | Taxi Service in Trivandrum and Kochi (Cochin)"
  description="JC Cabs is a taxi service in Trivandrum and Kochi (Cochin) for airport transfers, local and outstation trips, tour packages and corporate travel."
  overlay
>
  <PhotoHero
    image="munnar"
    alt="Tea plantations near Munnar, Kerala"
    title="About JC Cabs"
    intro="A taxi service for Trivandrum and Kochi (Cochin), for locals and visitors."
  />

  <section class="section grid gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h2>Who we are</h2>
      <p class="mt-3">
        JC Cabs provides airport pickups and drops, outstation trips, local trips, package tours, corporate trips
        and all other taxi services. We run hatchbacks, sedans, Ertigas and Innovas from our offices in
        Trivandrum and Kochi (Cochin), and we plan custom tours on request.
      </p>
      <p class="mt-3 text-muted">Our story, team and owner photo: TBD.</p>
    </div>
    <dl>
      {
        facts.map((fact) => (
          <div class="flex justify-between gap-4 border-b border-line py-3 first:border-t">
            <dt class="font-medium">{fact.label}</dt>
            <dd class="text-right text-muted">{fact.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <CtaBand />
</BaseLayout>

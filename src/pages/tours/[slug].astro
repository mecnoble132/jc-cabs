---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import tours from '../../data/tours.json';
import { telLink, waLink } from '../../lib/contact';

export function getStaticPaths() {
  return tours.map((tour) => ({ params: { slug: tour.slug }, props: { tour } }));
}

const { tour } = Astro.props;
const others = tours.filter((t) => t.slug !== tour.slug);
const message = `Hi, I'd like to enquire about the ${tour.name} tour package.`;
---

<BaseLayout
  title={`${tour.name} Tour Package from Trivandrum and Kochi (Cochin) | JC Cabs`}
  description={`${tour.summary} Private taxi tour with a driver from Trivandrum or Kochi (Cochin), customised for you.`}
  overlay
>
  <PhotoHero image={tour.image ?? 'kerala'} alt={`${tour.name}, Kerala`} title={`${tour.name} tour`} intro={tour.summary}>
    <div class="mt-5 flex flex-col gap-2 sm:flex-row">
      <Button href={waLink(message)} variant="whatsapp" track="tour_enquire">
        <Icon name="chat" class="h-4 w-4" />
        Enquire on WhatsApp
      </Button>
      <Button href={telLink()} variant="call-dark" track="click_call">
        <Icon name="phone" class="h-4 w-4" />
        Call
      </Button>
    </div>
  </PhotoHero>

  <section class="section grid gap-10 lg:grid-cols-[2fr_1fr] lg:gap-16">
    <div>
      <h2>Planned around you</h2>
      <p class="mt-3 text-muted">
        {tour.name} is a suggested destination, not a fixed package. There is no set route or itinerary: the places,
        the number of days and the car are all up to you.
      </p>
      <ol class="mt-5">
        <li class="border-b border-line py-3 first:border-t">Message us on WhatsApp with your dates, group size and the places you want to see.</li>
        <li class="border-b border-line py-3">We suggest a plan and send you a quote.</li>
        <li class="border-b border-line py-3">You confirm on WhatsApp and we send the car and driver.</li>
      </ol>
    </div>
    <dl class="self-start">
      <div class="flex justify-between gap-4 border-y border-line py-3">
        <dt class="font-medium">Price</dt>
        <dd class="text-right text-muted">Customised for you</dd>
      </div>
      <div class="flex justify-between gap-4 border-b border-line py-3">
        <dt class="font-medium">Vehicles</dt>
        <dd class="text-right text-muted">Any car in our fleet</dd>
      </div>
    </dl>
  </section>

  <section class="bg-cream">
    <div class="section">
      <h2>Other tours</h2>
      <ul class="mt-4 grid gap-x-10 sm:grid-cols-2">
        {
          others.map((other) => (
            <li class="border-b border-line">
              <a href={`/tours/${other.slug}`} class="flex items-center justify-between gap-4 py-3 font-medium">
                {other.name}
                <Icon name="arrow" class="h-4 w-4 text-muted" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-5 text-sm text-muted">
        Want something different? <a href={`/tours?destination=${encodeURIComponent(tour.name)}#custom`} class="font-medium text-ink underline underline-offset-4">Ask for a custom tour</a>.
      </p>
    </div>
  </section>
</BaseLayout>

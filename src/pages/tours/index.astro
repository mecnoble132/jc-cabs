---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TourCard from '../../components/TourCard.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import tours from '../../data/tours.json';
import CustomTourForm from '../../components/CustomTourForm.astro';
---

<BaseLayout
  title="Kerala Tour Packages from Trivandrum and Kochi (Cochin) | JC Cabs"
  description="Munnar, Alleppey, Thekkady, Varkala, Kanyakumari and Kerala 5 and 7 day tour packages by taxi, customised for you."
>
  <section class="section">
    <h1>Tour packages</h1>
    <p class="mt-3 max-w-xl text-muted">
      These are suggested destinations, not fixed packages. Every tour is customised for you and planned with you on WhatsApp.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
      <Button href="#custom" variant="whatsapp" track="tour_enquire">
        <Icon name="chat" class="h-4 w-4" />
        Plan a custom tour
      </Button>
      <span class="text-sm text-muted">Tell us the places, days and group size.</span>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        tours.map((tour, i) => (
          <TourCard
            tour={tour}
            featured={i === 0}
            class={i === 0 ? 'sm:col-span-2 lg:col-span-2 lg:row-span-2' : i === 5 ? 'sm:col-span-2 lg:col-span-1' : ''}
          />
        ))
      }
    </div>
  </section>

  <section id="custom" class="scroll-mt-16 bg-cream lg:scroll-mt-20">
    <div class="section">
      <h2>Want something different?</h2>
      <p class="mt-2 max-w-xl text-muted">
        We plan custom tours to your request. Tell us the places, the number of days, your group size and the
        vehicle you prefer, and we will send you a plan and a quote on WhatsApp.
      </p>
      <div class="mt-5">
        <CustomTourForm />
      </div>
    </div>
  </section>
</BaseLayout>

---
import LegalPage from '../components/LegalPage.astro';
---

<LegalPage
  title="Cancellation and refund policy"
  description="How to cancel a JC Cabs booking, and when refunds apply."
  draft={false}
>
  <h2>How to cancel or change</h2>
  <p>Call or WhatsApp us with your booking details as early as you can.</p>

  <h2>Refunds</h2>
  <ul>
    <li>Cancel at least 6 hours before your pickup time: you get a refund.</li>
    <li>Cancel less than 6 hours before your pickup time: no refund.</li>
  </ul>
</LegalPage>

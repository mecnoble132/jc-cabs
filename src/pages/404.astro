---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { telLink, waLink } from '../lib/contact';
---

<BaseLayout title={`Page not found | ${site.name}`} description="This page does not exist. Book a taxi or find what you need from here." noindex>
  <section class="section">
    <p class="text-sm font-medium text-muted">404</p>
    <h1 class="mt-1">We couldn't find that page</h1>
    <p class="mt-3 max-w-xl text-muted">
      The link may be old or mistyped. You can still book a taxi, or call or WhatsApp us and we'll help right away.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="/">Go to home page</Button>
      <Button href={telLink()} variant="call" track="call_click">
        <Icon name="phone" class="h-4 w-4" />
        Call {site.phoneDisplay}
      </Button>
      <Button href={waLink("Hi, I'd like to book a taxi.")} variant="whatsapp" track="whatsapp_click">
        <Icon name="chat" class="h-4 w-4" />
        WhatsApp
      </Button>
    </div>
    <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {site.nav.map((item) => <li><a href={item.href} class="font-medium underline underline-offset-4">{item.label}</a></li>)}
    </ul>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { telLink, waLink, type CityKey } from '../lib/contact';

const cities = Object.entries(site.cities) as [CityKey, (typeof site.cities)[CityKey]][];
---

<BaseLayout
  title="Contact JC Cabs | Taxi in Trivandrum and Kochi (Cochin)"
  description="Call, WhatsApp or email JC Cabs. Offices in Trivandrum and Kochi (Cochin), open 24 hours."
>
  <section class="section">
    <h1>Contact us</h1>
    <p class="mt-3 max-w-xl text-muted">Call or WhatsApp for the fastest reply. We are open 24 hours.</p>

    <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
      {
        cities.map(([key, city]) => (
          <div>
            <h2>{city.label}</h2>
            <dl class="mt-3">
              <div class="flex justify-between gap-4 border-b border-line py-3">
                <dt class="font-medium">Address</dt>
                <dd class="text-right text-muted">{city.address}</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-line py-3">
                <dt class="font-medium">Hours</dt>
                <dd class="text-right text-muted">{city.hours}</dd>
              </div>
            </dl>
            <div class="mt-4 flex flex-wrap gap-2">
              <Button href={telLink(key)} variant="call" track="click_call" city={key}>
                <Icon name="phone" class="h-4 w-4" />
                Call: {city.phoneDisplay}
              </Button>
              <a href={`/taxi-in-${key}`} class="inline-flex min-h-11 items-center text-sm font-medium underline underline-offset-4">
                Taxi in {city.label}
              </a>
            </div>
            <!-- Google Maps embed goes here once the office address is confirmed -->
            <div class="mt-4 grid aspect-[16/9] place-items-center rounded-xl border border-line bg-cream p-4 text-center text-sm text-muted">
              Map appears once the office address is confirmed.
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="bg-cream">
    <div class="section grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div>
        <h2>Send an enquiry</h2>
        <p class="mt-2 text-muted">For quotes, custom tours and corporate bookings.</p>
        <p class="mt-5">
          <a href={waLink()} data-track="click_whatsapp" class="font-medium underline underline-offset-4">WhatsApp: {site.whatsappDisplay}</a>
        </p>
        <p class="mt-1">
          <a href={`mailto:${site.email}`} class="font-medium underline underline-offset-4">{site.email}</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

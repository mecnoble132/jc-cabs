---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import OfficeMap from '../components/OfficeMap.astro';
import site from '../data/site.json';
import { telLink, waLink, type CityKey } from '../lib/contact';

const office = site.office;
const cities = Object.entries(site.cities) as [CityKey, (typeof site.cities)[CityKey]][];
---

<BaseLayout
  title="Contact JC Cabs | Taxi in Trivandrum and Kochi (Cochin)"
  description="Call, WhatsApp or email JC Cabs. Office in Trivandrum, serving Trivandrum and Kochi (Cochin), open 24 hours."
>
  <section class="section">
    <h1>Contact us</h1>
    <p class="mt-3 max-w-xl text-muted">Call or WhatsApp for the fastest reply. We are open 24 hours.</p>

    <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
      <div>
        <h2>Our office</h2>
        <dl class="mt-3">
          <div class="flex justify-between gap-4 border-b border-line py-3">
            <dt class="font-medium">Address</dt>
            <dd class="text-right text-muted">{office.address}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-line py-3">
            <dt class="font-medium">Hours</dt>
            <dd class="text-right text-muted">{office.hours}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-line py-3">
            <dt class="font-medium">We serve</dt>
            <dd class="text-right text-muted">
              {cities.map(([key, city], i) => (
                <>
                  {i > 0 && ' and '}
                  <a href={`/taxi-in-${key}`} class="underline underline-offset-4">{city.label}</a>
                </>
              ))}
            </dd>
          </div>
        </dl>
        <div class="mt-4">
          <Button href={telLink()} variant="call" track="click_call">
            <Icon name="phone" class="h-4 w-4" />
            Call: {site.phoneDisplay}
          </Button>
        </div>
      </div>
      <OfficeMap />
    </div>
  </section>

  <section class="bg-cream">
    <div class="section grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div>
        <h2>Send an enquiry</h2>
        <p class="mt-2 text-muted">For quotes and custom tours.</p>
        <p class="mt-5">
          <a href={waLink()} data-track="click_whatsapp" class="font-medium underline underline-offset-4">WhatsApp: {site.whatsappDisplay}</a>
        </p>
        <p class="mt-1">
          <a href={`mailto:${site.email}`} class="font-medium underline underline-offset-4">{site.email}</a>
        </p>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

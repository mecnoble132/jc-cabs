---
import '../styles/global.css';
import site from '../data/site.json';
import type { CityKey } from '../lib/contact';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyContactBar from '../components/StickyContactBar.astro';

interface Props {
  title: string;
  description?: string;
  /** Set on city pages for call tracking. */
  city?: CityKey;
  /** Let a full-bleed hero sit under the floating navbar (home page). Other pages get top padding. */
  overlay?: boolean;
  /** Keep this page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, description = site.description, city, overlay = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Business details for Google (structured data). Everything comes from site.json, so it stays in step with
// the phone, address and hours shown on the page. Test with https://search.google.com/test/rich-results
const home = new URL('/', Astro.site).href;
const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${home}#business`,
  additionalType: 'https://schema.org/TaxiService',
  name: site.name,
  description: site.description,
  slogan: site.tagline,
  url: home,
  logo: new URL('/favicon.png', Astro.site).href,
  image: new URL('/og-image.jpg', Astro.site).href,
  telephone: site.phone,
  email: site.email,
  priceRange: '₹₹',
  currenciesAccepted: 'INR',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Nallikuzhi',
    addressLocality: site.office.label,
    addressRegion: 'Kerala',
    postalCode: '695541',
    addressCountry: 'IN',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.office.lat, longitude: site.office.lng },
  hasMap: site.office.mapsUrl,
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  areaServed: [
    { '@type': 'City', name: 'Thiruvananthapuram (Trivandrum)' },
    { '@type': 'City', name: 'Kochi (Cochin)' },
    { '@type': 'State', name: 'Kerala' },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.phone,
    contactType: 'reservations',
    availableLanguage: ['English', 'Malayalam'],
    areaServed: 'IN',
  },
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: home, publisher: { '@id': `${home}#business` } };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="JC Cabs logo: taxi in Trivandrum and Kochi" />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <script type="application/ld+json" set:html={JSON.stringify(website)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-full focus:bg-brass-light focus:px-5 focus:py-3 focus:font-semibold focus:text-forest"
    >
      Skip to content
    </a>
    <Header city={city} />
    <main id="main" class:list={[!overlay && 'pt-16 lg:pt-20']}>
      <slot />
    </main>
    <!-- Bottom padding keeps the footer's last row clear of the mobile sticky bar -->
    <div class="bg-forest pb-24 lg:pb-0">
      <Footer />
    </div>
    <StickyContactBar city={city} />
  </body>
</html>
